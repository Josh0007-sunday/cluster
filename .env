# ── Cluster env (Vite: VITE_ prefix is required for client exposure) ──
# Reown AppKit (WalletConnect Cloud) — get one at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=d596aebd112eb50b6b1af9214c8dbccc

# Solana RPC
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/
VITE_HELIUS_API_KEY=f9a619f4-308f-41a8-935f-43d89b0d3c3e


# Circle — StableFX (quotes → trades) + Bridge Kit telemetry
# StableFX base: https://api.circle.com/v1/exchange/stablefx
VITE_CIRCLE_API_KEY=LIVE_API_KEY:3841b815929f3962720d08db510c2fe4:9419f684e976aba72a113dc382bba4ec
VITE_CIRCLE_STABLEFX_BASE_URL=https://api.circle.com/v1/exchange/stablefx
# Bridge Kit needs NO kit key for bridge(); Swap/ AppKit server-side needs KIT_KEY (keep server-only in prod)
VITE_CIRCLE_KIT_KEY=

# Kamino (REST read-only, no key needed) — default USDC vault override
# List: GET https://api.kamino.finance/kvaults/vaults
VITE_KAMINO_API_BASE=https://api.kamino.finance
VITE_KAMINO_USDC_VAULT=

# Chains enabled for this phase (comma list, must match src/config/chains.ts ids)
VITE_ENABLED_CHAINS=solana,ethereum,base,arbitrum,polygon,sei,sonic,unichain,worldchain

# Misc
VITE_APP_NAME=Cluster
VITE_APP_ENV=development

# Jupiter Trigger (moved to client)
VITE_JUPITER_API_KEY=jup_db7a9589039af06b6fe5f7c7d005bb103147859761f0e64c469319570e83a544
